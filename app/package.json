{
  "name": "fazendados",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm dev:all",
    "dev:all": "concurrently -k -n api,web -c green,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs watch src/server/index.ts",
    "dev:web": "vite",
    "build": "NODE_ENV=production vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "start:local": "node --env-file-if-exists=.env dist/db/migrate.js && node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "preview": "vite preview",
    "db:up": "docker compose up -d fazendados-db && pnpm db:wait",
    "db:wait": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs scripts/wait-for-db.ts",
    "db:down": "docker compose down",
    "db:restart": "docker compose restart fazendados-db",
    "db:logs": "docker compose logs -f fazendados-db",
    "db:status": "docker compose ps",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "db:reset": "docker compose down -v && pnpm db:setup",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/db/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@hono/node-server": "^1.14.1",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.7.11",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "recharts": "^3.9.2",
    "tsx": "^4.19.4",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.1",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
