NODE_ENV=development
# A API roda em 3001; o Vite roda em 5180 e encaminha /api para a API.
PORT=3001
DATABASE_URL=postgresql://fazendados:fazendados@localhost:5432/fazendados
# Apenas para o usuário local semeado `otavio`; não é usada pela API.
SEED_PASSWORD=fazendados
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_INTENT_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_TIMEOUT_MS=20000
PUBLIC_APP_URL=http://localhost:5180
# Referências Railway do Bucket (mantenha o objeto privado; não configure URL pública).
# MEDIA_BUCKET_ENDPOINT=${{bucket.ENDPOINT}}
# MEDIA_BUCKET_NAME=${{bucket.BUCKET}}
# MEDIA_BUCKET_ACCESS_KEY_ID=${{bucket.ACCESS_KEY_ID}}
# MEDIA_BUCKET_SECRET_ACCESS_KEY=${{bucket.SECRET_ACCESS_KEY}}
# MEDIA_BUCKET_REGION=${{bucket.REGION}}
